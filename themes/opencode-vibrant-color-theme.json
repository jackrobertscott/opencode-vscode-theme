    "titleBar.inactiveBackground": "#0a0a0a",
    "titleBar.inactiveForeground": "#9b9b9b",
    "menu.background": "#141414",
    "menu.foreground": "#f2f2f2",
    "menu.selectionBackground": "#282828",
    "menu.selectionForeground": "#f2f2f2",
    "menubar.selectionBackground": "#141414",
    "menubar.selectionForeground": "#f2f2f2",
    "notificationCenter.border": "#484848",
    "notificationCenterHeader.background": "#141414",
    "notificationToast.border": "#484848",
    "notifications.background": "#141414",
    "notifications.border": "#484848",
    "notifications.foreground": "#f2f2f2",
    "notificationsErrorIcon.foreground": "#ff6f7c",
    "notificationsInfoIcon.foreground": "#00bbcc",
    "notificationsWarningIcon.foreground": "#fca000",
    "quickInput.background": "#141414",
    "quickInput.foreground": "#f2f2f2",
    "quickInputTitle.background": "#1e1e1e",
    "pickerGroup.border": "#282828",
    "pickerGroup.foreground": "#ff9b54",
    "terminal.background": "#0a0a0a",
    "terminal.foreground": "#f2f2f2",
    "terminal.ansiBlack": "#0a0a0a",
    "terminal.ansiBlue": "#65a6ff",
    "terminal.ansiBrightBlack": "#606060",
    "terminal.ansiBrightBlue": "#65a6ff",
    "terminal.ansiBrightCyan": "#00bbcc",
    "terminal.ansiBrightGreen": "#00dc5d",
    "terminal.ansiBrightMagenta": "#b489ff",
    "terminal.ansiBrightRed": "#ff6f7c",
    "terminal.ansiBrightWhite": "#f2f2f2",
    "terminal.ansiBrightYellow": "#eaab00",
    "terminal.ansiCyan": "#00bbcc",
    "terminal.ansiGreen": "#00dc5d",
    "terminal.ansiMagenta": "#b489ff",
    "terminal.ansiRed": "#ff6f7c",
    "terminal.ansiWhite": "#f2f2f2",
    "terminal.ansiYellow": "#fca000",
    "terminalCursor.foreground": "#ff9b54",
    "breadcrumb.background": "#0a0a0a",
    "breadcrumb.foreground": "#9b9b9b",
    "breadcrumb.focusForeground": "#f2f2f2",
    "breadcrumb.activeSelectionForeground": "#ff9b54",
    "gitDecoration.addedResourceForeground": "#00d4b9",
    "gitDecoration.deletedResourceForeground": "#ff6e81",
    "gitDecoration.ignoredResourceForeground": "#606060",
    "gitDecoration.modifiedResourceForeground": "#ff9b54",
    "gitDecoration.untrackedResourceForeground": "#00d4b9",
    "diffEditor.border": "#484848",
    "diffEditor.insertedTextBackground": "#00324c",
    "diffEditor.removedTextBackground": "#43172f",
    "diffEditor.insertedLineBackground": "#00324c",
    "diffEditor.removedLineBackground": "#43172f",
    "diffEditor.diagonalFill": "#282828",
    "diffEditor.unchangedRegionBackground": "#141414",
    "diffEditor.unchangedRegionForeground": "#9e9e9e",
    "diffEditor.unchangedRegionShadow": "#0a0a0a00",
    "diffEditorGutter.insertedLineBackground": "#00324c",
    "diffEditorGutter.removedLineBackground": "#43172f",
    "diffEditorOverview.insertedForeground": "#00d4b9",
    "diffEditorOverview.removedForeground": "#ff6e81",
    "minimapGutter.addedBackground": "#00d4b9",
    "minimapGutter.deletedBackground": "#ff6e81",
    "minimapGutter.modifiedBackground": "#ff9b54",
    "merge.border": "#484848",
    "merge.currentContentBackground": "#00324c",
    "merge.currentHeaderBackground": "#00324c",
    "merge.incomingContentBackground": "#43172f",
    "merge.incomingHeaderBackground": "#43172f",
    "settings.headerForeground": "#ff9b54",
    "settings.modifiedItemIndicator": "#ff9b54",
    "welcomePage.progress.background": "#1e1e1e",
    "welcomePage.progress.foreground": "#ff9b54"
