  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989898",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#b489ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#ff9b54"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#00dc5d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#fca000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#eaab00"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#ff6f7c"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "property"
      ],
      "settings": {
        "foreground": "#ff6f7c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#fca000"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ff6f7c"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00bbcc"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#00bbcc"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#eeeeee"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#b489ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.strong"
      ],
      "settings": {
        "foreground": "#ffefde",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#eaab00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ff9b54"
      }
    },
    {
      "scope": "markup.raw.inline",
      "settings": {
        "foreground": "#00dc5d"
      }
    },
    {
      "scope": "markup.raw.block",
      "settings": {
        "foreground": "#dfb100"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#ff9b54"
      }
    },
    {
      "scope": [
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#00bbcc"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#eaab00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "markup.diff.header.to-file",
        "diff.plus"
      ],
      "settings": {
        "foreground": "#00d4b9",
        "background": "#00324c"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "markup.diff.header.from-file",
        "diff.minus"
      ],
      "settings": {
        "foreground": "#ff6e81",
        "background": "#43172f"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.delta"
      ],
      "settings": {
        "foreground": "#8c9bff",
        "background": "#141414"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "meta.diff.range",
        "markup.diff"
      ],
      "settings": {
        "foreground": "#8c9bff"
      }
    },
    {
      "scope": "punctuation.definition.inserted.diff",
      "settings": {
        "foreground": "#9edb00"
      }
    },
    {
      "scope": "punctuation.definition.deleted.diff",
      "settings": {
        "foreground": "#ff8891"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#ff6f7c"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#eaab00",
    "decorator": "#fca000",
    "enum": "#eaab00",
    "enumMember": "#fca000",
    "function": "#ff9b54",
    "interface": "#eaab00",
    "keyword": "#b489ff",
    "label": "#00bbcc",
    "method": "#ff9b54",
    "namespace": "#eaab00",
    "number": "#fca000",
    "operator": "#00bbcc",
    "parameter": "#ff6f7c",
    "property": "#ff6f7c",
    "string": "#00dc5d",
    "struct": "#eaab00",
    "type": "#eaab00",
    "typeParameter": "#eaab00",
    "variable": "#ff6f7c"
  }
}
